PORT=4000
NODE_ENV=development

# Supabase Project URL (Settings → API → Project URL)
# ต้องเป็น https://xxxxx.supabase.co — ไม่ใช่ postgresql:// connection string
SUPABASE_URL=https://your-project-ref.supabase.co

# Settings → API → service_role key (secret — ห้ามใส่ฝั่ง frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Frontend URL(s) for CORS — comma-separated for multiple origins
# Local:      http://localhost:3000
# Production: https://blog-app-gamma-eight-73.vercel.app
# No trailing slash. FRONTEND_URL is an alias for CLIENT_URL.
CLIENT_URL=http://localhost:3000

# Optional fallback when CLIENT_URL is still localhost on Vercel deploy
# Allows https://blog-app*.vercel.app origins automatically
CORS_VERCEL_PREFIXES=blog-app

# VERCEL=1 is set automatically on Vercel — do not add locally
